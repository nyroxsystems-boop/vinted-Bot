# ──────────────────────────────────────────────────────────────────────────────
# Vinted-System — Environment Variables
# Copy to .env and fill in. NEVER commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── General ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# true = headless, false = visible browser window (recommended for first login)
HEADLESS=false

# ── Ports ─────────────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=4700
VINTED_BOT_PORT=4701
DASHBOARD_PORT=5173

# ── Vinted ────────────────────────────────────────────────────────────────────
VINTED_BASE_URL=https://www.vinted.de
# Email only — password is typed manually during `npm run vinted:login`.
VINTED_EMAIL=
# Polling interval in seconds (how often bot checks for new chat messages)
VINTED_POLL_INTERVAL_S=60

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./orchestrator/data/vinted-system.db

# ── CJ Dropshipping ──────────────────────────────────────────────────────────
# Sign up at https://cjdropshipping.com → Settings → API
# Docs: https://developers.cjdropshipping.com
CJ_EMAIL=
CJ_PASSWORD=
CJ_SERVICE_PORT=4702
# Safety limits
CJ_MAX_ORDER_EUR=30
CJ_MAX_DAILY_ORDERS=50

# ── Multi-Marketplace Bot Ports ──────────────────────────────────────────────
KLEINANZEIGEN_BOT_PORT=4703
MERCARI_BOT_PORT=4704
DEPOP_BOT_PORT=4705
WALLAPOP_BOT_PORT=4706
EBAY_DE_BOT_PORT=4707
EBAY_UK_BOT_PORT=4708
ETSY_BOT_PORT=4709
GRAILED_BOT_PORT=4710
FB_MARKETPLACE_BOT_PORT=4711
VESTIAIRE_BOT_PORT=4712
WHATNOT_BOT_PORT=4713
# EU Champions (run inside orchestrator via eu-marketplace-bots.ts)
# LEBONCOIN_BOT_PORT=4714
# MARKTPLAATS_BOT_PORT=4715
# WILLHABEN_BOT_PORT=4716
# SUBITO_BOT_PORT=4717
# RICARDO_BOT_PORT=4718

# ── eBay Sell API ────────────────────────────────────────────────────────────
# Developer Account: https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE=EBAY_DE

# ── Etsy Open API v3 ────────────────────────────────────────────────────────
# Developer Account: https://www.etsy.com/developers
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=

# ── Shopify Admin API ────────────────────────────────────────────────────────
# Your Shopify store → Settings → Apps → Develop apps
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=

# ── WooCommerce REST API ─────────────────────────────────────────────────────
# Your WordPress → WooCommerce → Settings → Advanced → REST API
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ── AI: Reply Autopilot ──────────────────────────────────────────────────────
# Used for AI-powered buyer chat responses
ANTHROPIC_API_KEY=

# ── Alerts: Telegram Notifications ───────────────────────────────────────────
# Create a bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Auto-Crosslisting ───────────────────────────────────────────────────────
# JSON array of marketplace IDs to auto-crosslist after Vinted publish.
# Set in DB Settings or here. Example:
# AUTO_CROSSLIST_TARGETS=["kleinanzeigen","ebay_de","shopify"]

# ── Orchestrator ──────────────────────────────────────────────────────────────
# Global master switch — if true, NO bot action is taken. UI can also toggle this.
PAUSED=false
