node_modules/
dist/
build/
# Rust / Tauri build artefacts
app/src-tauri/target/
app/src-tauri/gen/
# Bundled-payload directory — populated by scripts/stage-bundle.mjs in CI.
# We commit the empty placeholder structure (via .gitkeep) so dev builds
# don't fail on missing resources, but the actual ~1 GB payload never
# touches git.
app/src-tauri/payload/*
!app/src-tauri/payload/system/
!app/src-tauri/payload/node/
!app/src-tauri/payload/playwright-browsers/
app/src-tauri/payload/*/*
!app/src-tauri/payload/*/.gitkeep
.env
.env.local
*.log
logs/
playwright-data/
!playwright-data/.gitkeep
**/data/*.db
**/data/*.db-journal
**/data/*.db-wal
**/data/*.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm
.DS_Store
*.tsbuildinfo

# macOS extended-attribute resource forks (created by Finder/Time-Machine).
# Always junk in git.
._*

# Python venv used by some scripts
venv/

# Loop-cycle scratchpads
_loop_*.md
_loop_*.txt
_logs/

# Backup snapshots created by in-app tarball updates
.backup/

# Temporary .env staging files
.env.tmp

# Bot data dirs (chromium-profiles, session storage, scraping cache)
# Multi-GB each — never commit.
/data/
*/data/
!*/data/.gitkeep
*-bot/data/
kleinanzeigen-bot/_diag/
*/playwright-data/
# Tarball snapshots of chromium-profiles taken by health-watcher
chromium-profile.flagged*.tgz
chromium-profile.*.tgz
