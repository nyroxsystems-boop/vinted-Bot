{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Vinted-System app",
  "windows": ["main", "dashboard"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-show",
    "shell:default",
    "shell:allow-open"
  ]
}
