    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc --bundles msi,nsis",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
